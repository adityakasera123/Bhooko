{
  "expo": {
    "name": "BHOOKO Delivery",
    "slug": "bhooko-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bhooko.delivery",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.bhooko.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BHOOKO uses your location to update customers about their active delivery.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BHOOKO shares rider location during an active delivery, including when the app is in the background."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BHOOKO needs your location during an active delivery.",
          "locationAlwaysAndWhenInUsePermission": "BHOOKO needs background location to keep customers updated during an active delivery.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6a859a2a-c8f3-4f7c-96f2-ecf071e258d9"
      }
    },
    "owner": "adityakasera"
  }
}
