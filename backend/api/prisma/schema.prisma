generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  DELIVERY_PARTNER
  ADMIN
}

enum RestaurantStatus {
  OPEN
  CLOSED
  PAUSED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurants       Restaurant[]
  customerAddresses CustomerAddress[]
  refreshTokens     RefreshToken[]
  cart              Cart?
  orders            Order[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Restaurant {
  id           String           @id @default(uuid())
  ownerId      String
  name         String
  description  String
  imageUrl     String
  latitude     Float
  longitude    Float
  addressLine1 String
  addressLine2 String?
  area         String
  city         String
  state        String
  pincode      String
  status       RestaurantStatus
  rating       Float            @default(0)
  reviewCount  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id])
  categories FoodCategory[]
  foodItems  FoodItem[]
  orders     Order[]

  @@index([ownerId])
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  customerId           String
  label                String
  line1                String
  line2                String?
  area                 String
  city                 String
  state                String
  pincode              String
  latitude             Float
  longitude            Float
  contactName          String
  contactPhone         String
  isDefault            Boolean  @default(false)
  deliveryInstructions String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model FoodCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  foodItems  FoodItem[]

  @@index([restaurantId])
}

model FoodItem {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String
  imageUrl     String
  priceInPaise Int
  isAvailable  Boolean  @default(true)
  foodType     FoodType
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  category   FoodCategory @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User       @relation(fields: [customerId], references: [id])
  items    CartItem[]
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  foodItemId String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart     Cart     @relation(fields: [cartId], references: [id])
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@unique([cartId, foodItemId])
  @@index([foodItemId])
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  restaurantId String
  status       OrderStatus @default(CREATED)

  // Historical restaurant snapshot
  restaurantName String

  // Historical delivery address snapshot
  deliveryAddressLabel   String
  deliveryContactName    String
  deliveryContactPhone   String
  deliveryAddressLine1   String
  deliveryAddressLine2   String?
  deliveryAddressArea    String
  deliveryAddressCity    String
  deliveryAddressState   String
  deliveryAddressPincode String
  deliveryLatitude       Float
  deliveryLongitude      Float
  deliveryInstructions   String?

  // Authoritative order totals
  itemSubtotalInPaise Int
  deliveryFeeInPaise  Int @default(0)
  platformFeeInPaise  Int @default(0)
  taxInPaise           Int @default(0)
  discountInPaise      Int @default(0)
  totalInPaise         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User        @relation(fields: [customerId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  foodItemId String?

  // Historical food snapshot
  foodItemName        String
  unitPriceInPaise    Int
  quantity            Int
  itemSubtotalInPaise Int

  createdAt DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([foodItemId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  status            PaymentStatus @default(CREATED)
  amountInPaise     Int
  currency          String        @default("INR")
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}